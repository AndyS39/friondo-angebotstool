# Vorlage für .env – kopieren nach .env und ausfüllen.
# Alle Pfad-/Wertangaben sind optional; ohne Eintrag gelten die Standardwerte aus config.py.

# Pfade (nur setzen, wenn abweichend vom Projektordner)
# PREISLISTE_PFAD=
# LOGIK_EXCEL_PFAD=
# LOGO_ORDNER=
# DATA_ORDNER=

# monday.com API-Token (optional)
MONDAY_API_TOKEN=

# Microsoft Graph für den E-Mail-Versand (Einrichtung: docs/graph-einrichtung.md)
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=

# Nächtliche Sicherung (scripts\backup-nacht.bat, Aufgabe „Friondo Backup“ 02:30):
# Zielordner, in den data\backups, data\angebote und data\projekte gespiegelt werden
# (UNC-Pfad oder Laufwerk, ohne Anführungszeichen; der Ordner muss für das Konto der
# Aufgabe beschreibbar sein). Standard: D:\Backup\Angebotstool
BACKUP_ZIEL=D:\Backup\Angebotstool
