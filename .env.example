# Vorlage für .env – kopieren nach .env und ausfüllen.
# Alle Pfad-/Wertangaben sind optional; ohne Eintrag gelten die Standardwerte aus config.py.

# Pfade (nur setzen, wenn abweichend vom Projektordner)
# PREISLISTE_PFAD=
# LOGIK_EXCEL_PFAD=
# LOGO_ORDNER=
# DATA_ORDNER=

# monday.com API-Token (optional)
MONDAY_API_TOKEN=

# Microsoft Graph für den E-Mail-Versand (Einrichtung: docs/graph-einrichtung.md)
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=

# Nächtliche Sicherung IM Tool (Scheduler 02:30, v27): Zielordner, in den data\backups,
# data\angebote, data\projekte und .env gespiegelt werden (UNC-Pfad oder Laufwerk, ohne
# Anführungszeichen; für eine Netzfreigabe braucht der Dienst ein Dienstkonto – SYSTEM
# hat dort keine Rechte). Leer = nur lokale Sicherung, /health meldet warn „kein
# Backup-Ziel“. scripts\backup-nacht.bat nutzt denselben Eintrag für Handläufe.
BACKUP_ZIEL=D:\Backup\Angebotstool

# --- v27 (PLAN_V17): Betrieb für 50 Nutzer --------------------------------------
# Verbindungspool und Threadpool (Standardwerte im Code; Invariante beim Start:
# DB_POOL_SIZE + DB_POOL_OVERFLOW >= WORKER_THREADS + Anzahl Scheduler + 5)
# DB_POOL_SIZE=20
# DB_POOL_OVERFLOW=40
# DB_POOL_TIMEOUT=10
# WORKER_THREADS=64
# Reverse-Proxy/HTTPS (IT-Zulieferung): Cookie secure+samesite=lax, absolute Links
# in Mails/ICS/Signatur-Links aus BASIS_URL (ohne Proxy: http://192.168.35.4:8000)
# HTTPS_AKTIV=0
# BASIS_URL=http://192.168.35.4:8000
# IP des Reverse-Proxys fuer uvicorn --proxy-headers --forwarded-allow-ips (start-Skripte)
# PROXY_IPS=127.0.0.1
